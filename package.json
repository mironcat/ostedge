{
  "name": "ostedge",
  "version": "0.1.0",
  "description": "Ostracod contour extraction and measurements (Electron + Vue + OpenCV.js)",
  "author": "OstEdge contributors",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-opencv.mjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "test:core": "node scripts/test-core.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:win:portable": "npm run build && electron-builder --win portable",
    "package:win": "powershell -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "package:win:portable": "powershell -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -Portable",
    "package:win:unpacked": "powershell -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -Unpacked"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@svgdotjs/svg.js": "^3.2.4",
    "@techstark/opencv-js": "4.12.0-release.1",
    "element-plus": "^2.9.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^26.18.0",
    "pngjs": "^7.0.0",
    "vite": "^6.0.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.ostedge.app",
    "productName": "OstEdge",
    "copyright": "Copyright © 2026 OstEdge",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OstEdge"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
